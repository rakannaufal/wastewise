{
  "expo": {
    "name": "WasteWise",
    "slug": "wastewise",
    "scheme": "wastewise",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "id.wastewise.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Ambil foto material untuk laporan WasteWise.",
        "NSPhotoLibraryUsageDescription": "Pilih foto material untuk laporan WasteWise.",
        "NSLocationWhenInUseUsageDescription": "Tambahkan lokasi saat ini ke laporan pilihanmu."
      }
    },
    "android": {
      "package": "id.wastewise.app",
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Ambil foto sampah untuk klasifikasi dan laporan WasteWise.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pilih foto material untuk WasteWise.",
          "cameraPermission": "Ambil foto material untuk WasteWise.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F7F4",
          "image": "./assets/brand/icon.png",
          "imageWidth": 128,
          "resizeMode": "contain"
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "icon": "./assets/brand/icon.png"
  }
}
